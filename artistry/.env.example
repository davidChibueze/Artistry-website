# Payload CMS API base URL — include the /api suffix, no trailing slash
# Dev: the CMS runs on :3000 by default
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Public site URL of this frontend — used for payment callback URLs, OG metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# PayPal client ID (sandbox or live). From the PayPal developer dashboard.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
