# Payload CMS Secret - Generate with: openssl rand -base64 32
PAYLOAD_SECRET=your_payload_secret_here

# Database connection string
# SQLite for development (default)
# DATABASE_URL=file:./payload.db
# PostgreSQL for production
DATABASE_URL=postgresql://user:password@localhost:5432/poshbugati

# Server URL - No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=your_cron_secret_here

# Secret used to validate preview requests
PREVIEW_SECRET=your_preview_secret_here

# Upload directory (local development)
UPLOAD_DIR=./media

# S3/Cloudflare R2 (production - optional)
# S3_BUCKET=your_bucket_name
# S3_REGION=your_region
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key

# Email (optional - Resend)
# RESEND_API_KEY=your_resend_api_key

# Payments - Credo (https://credocentral.com)
# Sandbox: https://app.credodemo.com | Production: https://app.credocentral.com
# Get keys from Settings > Developer > API Keys
CREDO_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
CREDO_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# Sandbox base URL: https://api.credodemo.com
# Production base URL: https://api.credocentral.com
CREDO_BASE_URL=https://api.credodemo.com
